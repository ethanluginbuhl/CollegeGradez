{
  "name": "collegegradez",
  "version": "0.2.0-beta.1",
  "description": "A college grade calculator for students",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "author": {
    "name": "Ethan Luginbuhl",
    "email": "66286359+ethanluginbuhl@users.noreply.github.com",
    "url": "https://github.com/ethanluginbuhl"
  },
  "build": {
    "appId": "com.ethanluginbuhl.collegegradez",
    "productName": "CollegeGradez",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "calc.js",
      "data-schema.js",
      "index.html",
      "main.js",
      "notification.js",
      "persistence.js",
      "package.json",
      "preload.js",
      "renderer.js",
      "styles.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "ethanluginbuhl",
      "repo": "CollegeGradez",
      "releaseType": "prerelease"
    }
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ethanluginbuhl"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.10"
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
